IDD_PRIVACY DIALOG DISCARDABLE  0, 0, 259, 146
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Privacy Mode"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,202,125,50,14
    LTEXT           "Privacy Mode is designed to allow you to packet collect without including your identity in the packet collection at all. When enabled it will selectively exclude packets which contain your characters name or guild from the collected files.",
                    IDC_STATIC,7,7,245,27
    LTEXT           "Your characters name is needed to be absolutely sure that it does not occurr anywhere in the file. ",
                    IDC_STATIC,7,44,245,19
    LTEXT           "Finally the Ignore World mode is designed to drop communications with the world server (character select), because we do not need this data at all.",
                    IDC_STATIC,7,73,245,19
END

IDD_DIALOG1 DIALOG DISCARDABLE  0, 0, 226, 77
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dialog"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "Yes",IDOK,169,56,50,14
    PUSHBUTTON      "No",IDCANCEL,7,56,50,14
    LTEXT           "Static",IDC_TEXT,7,7,212,39
END

IDD_MOBINFO DIALOG DISCARDABLE  0, 0, 318, 199
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
