				LinkIncremental="1"
				SuppressStartupBanner="TRUE"
				AdditionalLibraryDirectories="c:\mysql\lib\debug"
				ProgramDatabaseFile=".\Release/EQBuilder.pdb"
				SubSystem="2"
				TargetMachine="1"/>
